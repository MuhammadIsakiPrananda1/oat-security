# ---------------------------------------------------------------------------
# OAT Security server — MySQL (Laragon) lab
# ---------------------------------------------------------------------------
# Remote endpoint agents must reach this server directly. Bind 0.0.0.0 for the
# lab; in production place HTTPS (nginx/Caddy/Traefik) in front and restrict
# inbound access to the agent network.
HOST=0.0.0.0
PORT=3000

# MySQL 8. Run `npm run db:setup` once to create the database and app user.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oat
DB_PASSWORD=oat_security_2026
DB_NAME=oat_security

# Cross-compiled agent artifacts (run `npm run agent:build`).
AGENT_BIN_DIR=./agent/dist

# Replace these with long, random values before exposing the dashboard.
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-a-different-long-random-secret
CORS_ORIGINS=https://security.example.com

LOG_LEVEL=info

# Optional AI integrations.
GEMINI_API_KEY=
GROQ_API_KEY=

# Contact & Support channels shown in the console and on /contact.
# Leave SUPPORT_EMAIL empty to use security@<organization-domain>.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_ADDRESS=
SUPPORT_HOURS=24/7 SOC
SUPPORT_SLA=Critical incidents: 15 minutes · Standard requests: 1 business day
